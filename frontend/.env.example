VITE_MAPBOX_TOKEN=
VITE_API_BASE_URL=/api

# Milestone 1 presentation configuration.
# full        - normal application (default when this var is unset)
# milestone1  - public nav/homepage show only Home, Climate Intelligence,
#               Staff Login. GHG Inventory / Projects / Reports stay in the
#               codebase and remain reachable by direct URL, just hidden
#               from public navigation. See frontend/src/config/demoMode.js.
VITE_PUBLIC_DEMO_MODE=full

# Phase 1 minimum-viable public visitor analytics (Umami).
# Disabled by default. Public visitor tracking only — never enable this
# against a real Umami property using development traffic. The Umami
# instance URL and Website ID are provisioned and owned by the KCCC client;
# they are expected to be browser-visible once deployed, but deployment-
# specific values still belong in the deployment environment, not in this
# example file or any other source-controlled file.
VITE_ANALYTICS_ENABLED=false
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=
