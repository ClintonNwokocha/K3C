# Backend environment configuration template.
# Copy to backend/.env and fill in real values locally / per-deployment.
# Never commit backend/.env or put real secrets in this file.

# Django signing key. Required — the app now fails fast (raises
# ImproperlyConfigured) if this is unset. Use a long, random, unique value
# per environment; never reuse the same key across dev/staging/production.
SECRET_KEY=

# "True" only for local development. Must be "False" in any deployed
# environment (defaults to False when unset).
DEBUG=False

# PostgreSQL/PostGIS connection.
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Comma-separated list of hostnames this Django instance will answer for.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated list of origins allowed to make cross-origin requests to
# the API (the deployed frontend's exact origin(s), scheme+host+port).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of origins trusted for CSRF (relevant to Django
# Admin's session-cookie login; the JWT-authenticated DRF API itself does
# not rely on CSRF). Should match CORS_ALLOWED_ORIGINS in most setups.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Earth Engine project/auth. If GEE_SERVICE_ACCOUNT and
# GEE_PRIVATE_KEY_FILE are both left blank, GEE falls back to Application
# Default Credentials.
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=

# Climate Briefing Assistant (Grok/xAI) — backend-only. Never set XAI_API_KEY
# anywhere this file could be committed with a real value. When disabled or
# unconfigured, the Climate Atlas assistant transparently falls back to the
# existing rule-based briefing; the frontend never sees or needs this key.
CLIMATE_AI_ENABLED=false
XAI_API_KEY=
# Model name is configurable, not hard-coded, since available Grok model
# names can change (e.g. grok-4).
XAI_MODEL=
# Optional: comma-separated models tried in order (e.g. Groq: openai/gpt-oss-120b,llama-3.3-70b-versatile).
# A failing model is skipped for 5 minutes. XAI_API_BASE_URL may point at any OpenAI-compatible API.
XAI_MODELS=
CLIMATE_AI_TIMEOUT_SECONDS=8
